# Gemini API Key — single key or comma-separated pool for key rotation on rate limits
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Default batch size (number of images per API call, default: 5)
# BATCH_SIZE=5
